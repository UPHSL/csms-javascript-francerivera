<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= applicationName %></title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >
</head>

<body>
  <main class="container">
    <section class="card">
      <p class="label">
        Programming Languages Laboratory
      </p>

      <h1><%= applicationName %></h1>

      <p class="message">
        Starter application initialized successfully.
      </p>

      <dl class="details">
        <div>
          <dt>Current Sprint</dt>
          <dd><%= currentSprint %></dd>
        </div>

        <div>
          <dt>Technology</dt>
          <dd><%= technology %></dd>
        </div>

        <div>
          <dt>Version</dt>
          <dd><%= applicationVersion %></dd>
        </div>
      </dl>

      <div style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.75rem;">
        <a href="/dashboard" class="btn btn-primary" style="display: inline-block; padding: 0.75rem 1.5rem; background: #1e40af; color: #ffffff; text-decoration: none; border-radius: 0.5rem; font-weight: 600;">Open Dashboard</a>
        <a href="/residents" class="btn btn-secondary" style="display: inline-block; padding: 0.75rem 1.5rem; background: #2563eb; color: #ffffff; text-decoration: none; border-radius: 0.5rem; font-weight: 600;">Open Resident Management</a>
        <a href="/service-requests" class="btn btn-secondary" style="display: inline-block; padding: 0.75rem 1.5rem; background: #4b5563; color: #ffffff; text-decoration: none; border-radius: 0.5rem; font-weight: 600;">Open Service Request Management</a>
      </div>

      <p class="status" style="margin-top: 1.5rem;">
        Environment status: Ready
      </p>

      <footer class="portal-footer" style="margin-top: 2rem; border-top: 1px solid #e2e8f0; padding-top: 1rem; color: #64748b; font-size: 0.85rem;">
        <p>Community Services Management System &bull; Version <span class="release-version" style="font-weight: 700; color: #1e40af;">v<%= applicationVersion %></span></p>
      </footer>
    </section>
  </main>
</body>
</html>
