<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resident Not Found - Community Services Management System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <!-- Unified Municipal Portal Navigation Header -->
    <header class="page-header">
      <div class="header-container">
        <a href="/dashboard" class="header-brand-link">
          <div class="header-brand">
            <div class="header-brand-meta">
              <span class="portal-badge">Civic Portal</span>
              <span class="portal-version-badge">v<%= applicationVersion %></span>
            </div>
            <span class="portal-title">Community Services Management System</span>
          </div>
        </a>
        <nav class="portal-nav" aria-label="Main Navigation">
          <a href="/dashboard" class="nav-link">Dashboard</a>
          <a href="/residents" class="nav-link active" aria-current="page">Residents</a>
          <a href="/service-requests" class="nav-link">Service Requests</a>
        </nav>
      </div>
    </header>

    <main class="page-content not-found-layout">
      <div class="card not-found-card">
        <p class="label">404 - Not Found</p>
        <h1>Resident Not Found</h1>
        <p class="message">
          The requested Resident record does not exist or may have been removed.
        </p>
        <div class="actions">
          <a href="/residents" class="btn btn-primary">Return to Resident Management</a>
          <a href="/dashboard" class="btn btn-secondary">Dashboard</a>
        </div>
      </div>
    </main>

    <footer class="portal-footer">
      <div class="footer-container">
        <p>Community Services Management System &bull; Version <span class="release-version">v<%= applicationVersion %></span></p>
        <p class="footer-copy">&copy; 2026 CSMS Municipal Services. Production Release.</p>
      </div>
    </footer>
  </div>
</body>
</html>
