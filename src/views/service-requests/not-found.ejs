<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Service Request Not Found - Community Services Management System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <main class="page-content not-found-layout">
      <div class="card not-found-card">
        <p class="label">404 - Not Found</p>
        <h1>Service Request Not Found</h1>
        <p class="message">
          The requested Service Request record does not exist or may have been removed.
        </p>
        <div class="actions">
          <a href="/service-requests" class="btn btn-primary">Return to Service Requests</a>
          <a href="/residents" class="btn btn-outline">View Residents</a>
          <a href="/" class="btn btn-secondary">Home</a>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
